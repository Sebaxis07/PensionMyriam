# Copiar a app/.env (nunca commitear el real). Valores de desarrollo
# local que apuntan al stack de infra/docker-compose.yml.
#
# VITE_SUPABASE_ANON_KEY es un JWT HS256 con claim role=anon, firmado
# con el JWT_SECRET de desarrollo de infra/.env.example
# (changeme_at_least_32_characters_long). Es un secreto de desarrollo
# desechable, no una clave real — en producción se genera una nueva
# firmada con el JWT_SECRET real y nunca se commitea.
VITE_SUPABASE_URL=http://localhost:8080
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWRlbW8iLCJpYXQiOjE3OTA2NTM1NDUsImV4cCI6MjEwNjAxMzU0NX0.OwVPtP53rD1cExPxXwPlDfezNJTQdWaMZbyJHl78l50
VITE_POWERSYNC_URL=http://localhost:8081
